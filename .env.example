# PyAuthService Environment Configuration
# Copy this to .env and update with your values

# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Configuration
DATABASE_URL=postgresql://authuser:authpassword@db:5432/pyauthservice

# Service API Configuration
SERVICE_API_TOKEN=your-api-token-here
SERVICE_API_TOKEN_KEY=X-Status-Token

# Redis Cache (optional)
REDIS_URL=redis://cache:6379/0

# Home Page URL
HOME_URL=https://yourdomain.com
