# oauth2-proxy must use the same OAuth client registered in Django.
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.hacksaw.in/o
OAUTH2_PROXY_CLIENT_ID=nginx-gateway
OAUTH2_PROXY_CLIENT_SECRET=replace-with-client-secret
OAUTH2_PROXY_REDIRECT_URL=https://sso.hacksaw.in/oauth2/callback
OAUTH2_PROXY_SCOPE=openid email profile
# Optional when the authorization server requires PKCE globally.
# OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256

# Keep the browser session in HttpOnly cookies.
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-byte-base64url-secret
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_DOMAINS=.hacksaw.in
OAUTH2_PROXY_WHITELIST_DOMAINS=.hacksaw.in

# Forward the OAuth access token to the protected upstream.
OAUTH2_PROXY_PASS_ACCESS_TOKEN=true
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_REVERSE_PROXY=true